# =============================================================================
# Estimate Builder — environment variables
# Copy to .env.local and fill in values from Supabase.
# =============================================================================

# --- App ---
PORT=3100
# Public app URL (local). Production (Vercel): https://uupis.com — not the Supabase API host.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# --- Supabase (required for database) ---
# Dashboard → Project Settings → API
# Free plan: keep https://YOUR_PROJECT_REF.supabase.co
# After Pro Custom Domain: https://api.uupis.com (same anon/service keys)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# Optional Google email-domain lock (fallback). Prefer Integrācijas → Google in the app.
# ALLOWED_EMAIL_DOMAIN=mycompany.com

# Server only — NEVER expose in browser or commit real value to git
# Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Database password — only for local migrations (npm run db:migrate)
# Dashboard → Project Settings → Database → Database password
# SUPABASE_DB_PASSWORD=your_database_password
# Pooler region (Dashboard → Database → Connection string), default eu-west-1
# SUPABASE_DB_REGION=eu-west-1
# Or full connection string (recommended if direct db.* host fails on your network):
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:password@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# --- Optional distributed rate limiting ---
# Required only for multi-instance production deploys; local/single-instance uses in-process limits.
# UPSTASH_REDIS_REST_URL=https://YOUR_REDIS.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# --- Optional transactional email (Resend) ---
# Prefer enabling Resend in system admin → Integrācijas (/site_integrations).
# When Resend is enabled, the login screen also offers email/password register + sign-in
# (confirmation email via Resend). Env vars are a fallback when DB From/key fields are empty.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Estimate Builder <noreply@yourdomain.com>
