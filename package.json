{
  "name": "estimate-builder",
  "version": "1.4.11",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --max-http-header-size=65536 ./node_modules/next/dist/bin/next dev -p 3100",
    "build": "next build",
    "start": "node --max-http-header-size=65536 ./node_modules/next/dist/bin/next start -p 3100",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "audit:check": "node scripts/audit-check.mjs",
    "db:migrate": "node scripts/apply-migrations.mjs",
    "db:test": "node scripts/test-supabase.mjs",
    "postinstall": "node scripts/copy-pdf-worker.mjs && node scripts/patch-next-app-page-require.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "exceljs": "^4.4.0",
    "next": "16.2.12",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.18.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "pg": "^8.21.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "uuid": "^11.1.1",
    "sharp": "^0.35.0",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.17",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "brace-expansion@5": "5.0.9"
  }
}
